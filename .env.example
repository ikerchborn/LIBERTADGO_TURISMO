# Server configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection
# Requerido para persistencia permanente en producción (Cloud SQL / PostgreSQL 14+).
# Si no está definido, el sistema opera con el adaptador en memoria de desarrollo (desarrollo local/pruebas).
DATABASE_URL="postgresql://postgres:tu_password_seguro@localhost:5432/libertadgo?sslmode=disable"

# Seguridad y Autenticación
# Clave criptográfica para firma de tokens de sesión (mínimo 32 caracteres aleatorios en producción)
SESSION_SECRET="generar_clave_criptografica_aleatoria_super_segura_2026"

# Bootstrap de Administrador Inicial (Opcional)
# Si se proporcionan, se crea automáticamente la cuenta administradora al arrancar el servidor si no existe.
ADMIN_INITIAL_EMAIL="admin.turismo@libertadgo.pe"
ADMIN_INITIAL_PASSWORD="TuPasswordSeguroAdmin2026!"
ADMIN_INITIAL_NAME="Administrador LibertadGO"
